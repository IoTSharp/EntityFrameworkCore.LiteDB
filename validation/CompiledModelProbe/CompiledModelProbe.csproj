<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <DefineConstants Condition="Exists('Compiled/ProbeContextModel.cs')">$(DefineConstants);COMPILED_MODEL</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../IoTSharp.EntityFrameworkCore.LiteDB/IoTSharp.EntityFrameworkCore.LiteDB.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive; compile</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
