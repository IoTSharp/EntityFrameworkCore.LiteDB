<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>LiteDB provider for Entity Framework Core 10.</Description>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>IoTSharp.EntityFrameworkCore.LiteDB</AssemblyName>
    <RootNamespace>IoTSharp.EntityFrameworkCore.LiteDB</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageTags>Entity Framework Core;LiteDB</PackageTags>
    <LangVersion>latest</LangVersion>
    <Nullable>annotations</Nullable>
    <PackageId>IoTSharp.EntityFrameworkCore.LiteDB</PackageId>
    <Authors>IoTSharp</Authors>
    <Product>IoTSharp.EntityFrameworkCore.LiteDB</Product>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageReleaseNotes>EF Core 10 bulk update/delete, nested and optional complex properties, LiteDB generated expressions, expanded native queries, compiled model generation and explicit legacy data archives. Complex collections, precompiled queries and NativeAOT remain outside the supported contract; see SUPPORT.md.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/IoTSharp/EntityFrameworkCore.LiteDB</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/IoTSharp/EntityFrameworkCore.LiteDB</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright 2019-2026 IoTSharp</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LiteDB" Version="[5.0.21,6.0.0)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="[10.0.14,11.0.0)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive; compile" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="" />
    <None Include="..\SUPPORT.md" Pack="true" PackagePath="" />
    <None Include="..\UPSTREAM.md" Pack="true" PackagePath="" />
    <None Include="..\licenses\EFCore-MIT.txt" Pack="true" PackagePath="licenses/" />
    <None Include="..\docs\nuget-deprecation.md" Pack="true" PackagePath="docs/" />
    <None Include="..\docs\migration-archive.md" Pack="true" PackagePath="docs/" />
    <None Include="..\docs\compiled-model.md" Pack="true" PackagePath="docs/" />
  </ItemGroup>

</Project>
